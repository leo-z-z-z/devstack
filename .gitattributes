# 默认按文本处理，并在入库/检出时统一为 LF，避免跨平台 diff 噪音
* text=auto eol=lf

# Windows 批处理脚本必须保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.exe binary
*.dmg binary
*.zip binary
*.node binary
