{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron/main",
    "sourceMap": true,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "dist-electron/main/.tsbuildinfo"
  },
  "include": ["src/main", "src/shared"]
}
